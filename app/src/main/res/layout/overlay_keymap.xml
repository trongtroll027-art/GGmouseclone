<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.ggmouseclone.KeymapOverlayView
        android:id="@+id/keymap_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <Button
        android:id="@+id/btn_add_component"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="50dp"
        android:text="Thêm thành phần"
        android:background="@drawable/bg_neon_blue"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btn_aimlock_toggle"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:background="@drawable/bg_neon_blue"
        android:text="AIM"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />
</FrameLayout>
